{
  "version": 1,
  "id": "avatar-pro",
  "title": "Professional avatar",
  "canvas": { "width": 800, "height": 800, "background": null },
  "export": { "format": "png" },
  "layers": [
    { "id": "frame", "type": "group", "name": "Round frame", "mask": { "shape": "ellipse", "x": 0, "y": 0, "width": 800, "height": 800 }, "children": [
      { "id": "backdrop", "type": "fill", "name": "Backdrop", "fill": { "type": "radial", "stops": ["#cfe3ff", "#6f8fd8"], "cy": 0.35 } },
      { "id": "photo", "type": "image", "name": "Portrait", "src": "library:portrait", "x": 0, "y": 0, "width": 800, "height": 800, "fit": "cover", "focus": [0.5, 0.25], "mask": { "src": "assets/masks/photo-cutout.png" }, "filters": [{ "type": "surfaceBlur", "radius": 4, "threshold": 12, "amount": 0.5 }, { "type": "shadowsHighlights", "shadows": 20 }, { "type": "vibrance", "vibrance": 15 }] }
    ] }
  ]
}
