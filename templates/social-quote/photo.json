{
  "version": 1,
  "id": "social-quote",
  "title": "Quote post",
  "canvas": { "width": 1080, "height": 1080, "background": "#111111" },
  "layers": [
    { "id": "photo", "type": "image", "name": "Photo", "src": "library:landscape", "x": 0, "y": 0, "width": 1080, "height": 1080, "fit": "cover", "filters": [{ "type": "blur", "radius": 3 }, { "type": "look", "look": "matte", "amount": 0.8 }] },
    { "id": "shade", "type": "fill", "name": "Shade", "fill": { "type": "linear", "angle": 90, "stops": [[0, "rgba(10,10,14,0.25)"], [1, "rgba(10,10,14,0.75)"]] } },
