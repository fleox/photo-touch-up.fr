    { "id": "quote", "type": "text", "name": "Quote", "text": "The best view comes after the hardest climb.", "x": 120, "y": 420, "width": 840, "font": "playfair", "size": 76, "lineHeight": 1.15, "color": "#ffffff" },
    { "id": "author", "type": "text", "name": "Author", "text": "— Anonymous", "x": 124, "y": 820, "font": "inter", "weight": 600, "size": 34, "letterSpacing": 1, "color": "#f4d58d" }
  ]
